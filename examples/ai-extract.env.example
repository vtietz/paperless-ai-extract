# paperless-ai-extract settings. Copy to ai-extract.env (keep it out of Git: it
# contains the API token) and reference it with `env_file: ai-extract.env`.
# Do not reuse Paperless's docker-compose.env: its PAPERLESS_URL means the public URL.

# --- required ----------------------------------------------------------------
# Paperless API as reachable from this container (compose service name + port 8000).
PAPERLESS_URL=http://webserver:8000
# API token of a dedicated Paperless user (profile menu -> API token).
PAPERLESS_TOKEN=replace-with-token
# ollama (native API) or openai (OpenAI, vLLM, llama.cpp, LM Studio, LocalAI, LiteLLM ...)
LLM_PROVIDER=ollama
# ollama: http://ollama:11434   openai-compatible: include /v1, e.g. http://vllm:8000/v1
LLM_BASE_URL=http://ollama:11434
# A vision model for image mode, e.g. qwen3.5:4b, qwen2.5vl:7b, gpt-4o-mini
LLM_MODEL=qwen3.5:4b
# LLM_API_KEY=

# --- input -------------------------------------------------------------------
# image (default), text, or image+text
# INPUT_MODE=image
# PAE__INPUT__PAGES=1
# PAE__INPUT__MAX_EDGE=1120

# --- model parameters (YAML value) -----------------------------------------------
# PAE__LLM__OPTIONS={num_ctx: 4096, temperature: 0.1}
# PAE__LLM__TIMEOUT=300

# --- optional fields ---------------------------------------------------------------
# Tags, chosen only from existing tags (never inbox or queue tags)
# PAE__EXTRACTION__TAGS__ENABLED=true
# PAE__EXTRACTION__TAGS__ALLOWED=[Tax, Insurance, Health]
# PAE__EXTRACTION__TAGS__MAX_TAGS=3
# Document date: propose (default) or fill on the first analysis when printed
# PAE__EXTRACTION__DOCUMENT_DATE__ENABLED=true
# PAE__EXTRACTION__DOCUMENT_DATE__FIRST_RUN=propose
# Language for titles and document types (default: the document's language)
# PAE__EXTRACTION__LANGUAGE=English

# --- behaviour -------------------------------------------------------------------
# Fields the service may touch
# PAE__POLICY__FIELDS=[title, correspondent, document_type, tags, created]
# First analysis: fill_empty (default) or propose; later analyses: propose (default)
# PAE__POLICY__FIRST_RUN=fill_empty
# PAE__POLICY__RERUN=propose
# Language of notes: en or de
# PAE__POLICY__NOTES_LANGUAGE=en
# Create missing correspondents / document types (default true)
# PAE__TAXONOMY__CREATE_CORRESPONDENTS=true
# PAE__TAXONOMY__CREATE_DOCUMENT_TYPES=true

# --- queue -----------------------------------------------------------------------
# PAE__QUEUE__POLL_INTERVAL=30
# PAE__QUEUE__TAGS__PENDING=AI: pending
# PAE__QUEUE__TAGS__APPLY=AI: apply

# Larger setups (recipient field, aliases, articles, custom prompt): mount a YAML
# file at /config/config.yaml instead; these variables still override it.
